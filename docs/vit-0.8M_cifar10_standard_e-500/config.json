{
    "run_dirpath": "runs/vit-0.8M_cifar10_standard_e-500",
    "run_name_suffix": "vit-0.8M_standard_init-weights_e-500",
    "seed": 42,
    "data": {
        "train_split": "train",
        "val_split": "test",
        "test_split": null,
        "image_size": null,
        "batch_size": 128,
        "num_workers": 8,
        "persistent_workers": true,
        "pin_memory": true,
        "drop_last": true,
        "shuffle": true,
        "mixup_enabled": false,
        "cutmix_enabled": false
    },
    "model": {
        "embed_dim": 128,
        "hidden_dim": 256,
        "num_heads": 4,
        "num_layers": 6,
        "patch_size": 4,
        "num_channels": 3,
        "num_patches": 64,
        "num_classes": 10,
        "dropout": 0.1
    },
    "optimizer": {
        "name": "adamw",
        "lr": 0.0005,
        "weight_decay": 0.001,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-08
    },
    "scheduler": {
        "enabled": true
    },
    "trainer": {
        "max_epochs": 500,
        "accelerator": "auto",
        "devices": 1,
        "precision": "32-true",
        "log_every_n_steps": 1,
        "accumulate_grad_batches": 1,
        "limit_train_batches": 1.0,
        "limit_val_batches": 1.0,
        "limit_test_batches": 1.0
    },
    "logging": {
        "csv": true,
        "tensorboard": true
    }
}
